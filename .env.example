# Copy to .env for local development. Every value below has a development default in
# src/server/env.ts; production and selfhost must set all passwords (min. 12 characters).
APP_MODE=development
APP_URL=http://localhost:2042
PORT=2040

# Database (docker compose up -d postgres)
PGHOST=127.0.0.1
PGPORT=2041
EBB_DB_NAME=ebb
EBB_OWNER_PASSWORD=ebb_dev
EBB_APP_PASSWORD=ebb_dev
EBB_SYSTEM_PASSWORD=ebb_dev
EBB_AUTH_PASSWORD=ebb_dev
# Only for npm run db:test-setup
POSTGRES_SUPERUSER_URL=postgres://postgres:ebb_dev@127.0.0.1:2041/postgres

# Auth (production/selfhost: at least 32 random characters, e.g. openssl rand -base64 48)
AUTH_SECRET=development-only-secret-do-not-deploy-0000
# Mail: without SMTP_URL development captures mails at GET /api/dev/mails. Required in production.
# SMTP_URL=smtps://user:password@smtp.example.eu:465
MAIL_FROM=ebbe <no-reply@localhost>

# Billing (E8): Paddle. Without PADDLE_WEBHOOK_SECRET the webhook answers 503, so development needs
# no Paddle account. Price ids come from the Paddle dashboard; PRICE_BASE_ACTIVE picks which base
# plan a checkout offers (founder until the founder phase ends).
# PADDLE_WEBHOOK_SECRET=
# PADDLE_API_KEY=
# The client token belongs to Paddle.js in the browser and is no secret; the checkout needs it
# together with a price id. Its `test_` prefix switches the billing page to the sandbox.
# PADDLE_CLIENT_TOKEN=
# PADDLE_PRICE_FOUNDER=
# PADDLE_PRICE_STANDARD=
# PADDLE_PRICE_SEAT=
# PRICE_BASE_ACTIVE=founder
# TRIAL_REQUIRES_CARD=false
# MAX_EXTRA_SEATS=5

# Push (E9): VAPID keys. The pair below is for development only and was made with
# `npx web-push generate-vapid-keys`; production generates its own and sets them per deployment as
# a secret. Without all three values push stays off.
VAPID_PUBLIC_KEY=BLfRZDAJdm9S4gCXjchpOoqG8BXjNiLUhL_GPubRvOFNFoymy4UJC86vXd97FLcPRg3ztOx_7LEpd2LUWjdhULw
VAPID_PRIVATE_KEY=ztEUJ0pZPCBHuJ5o4xTLJ1TWYPB5GYCuWyOLu1PdDC4
VAPID_SUBJECT=mailto:dev@localhost
