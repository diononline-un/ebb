# Production stack (docker-compose.prod.yml). Copy to .env, then replace every change-me.
# Generate secrets with: openssl rand -hex 32
# src/server/env.ts validates this file: production needs APP_URL, SMTP_URL, every password with
# at least 12 characters and AUTH_SECRET with at least 32.

APP_MODE=production
APP_URL=https://change-me.example
PORT=2040
# NODE_ENV comes from the image (Dockerfile) and must not be overridden here.

# Database. Inside the compose network the service answers on postgres:5432.
PGHOST=postgres
PGPORT=5432
EBB_DB_NAME=ebb
EBB_OWNER_PASSWORD=change-me
EBB_APP_PASSWORD=change-me
EBB_SYSTEM_PASSWORD=change-me
EBB_AUTH_PASSWORD=change-me
# Superuser of the postgres container; the backup and restore scripts use this password.
POSTGRES_PASSWORD=change-me
# POSTGRES_SUPERUSER_URL is only for npm run db:test-setup and has no place in production.

# Sessions and tokens (Better Auth).
AUTH_SECRET=change-me

# Mail. Production refuses to start without SMTP_URL.
SMTP_URL=smtps://change-me:change-me@smtp.change-me.example:465
MAIL_FROM=ebb <no-reply@change-me.example>

# VAPID keys for Web Push come with E9-P1. Until then this file has no push variables.

# Billing (Paddle). Leave empty until the "Paddle live schalten" section in docs/betrieb.md is done;
# the webhook then answers 503 instead of pretending to be configured.
PADDLE_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_PRICE_FOUNDER=
PADDLE_PRICE_STANDARD=
PADDLE_PRICE_SEAT=
PRICE_BASE_ACTIVE=founder
TRIAL_REQUIRES_CARD=false
MAX_EXTRA_SEATS=5

# Caddy asks for the public hostname; compose asks for the image tag (a v* release tag).
EBB_DOMAIN=change-me.example
EBB_VERSION=change-me

# Backup service: hour in UTC (0-23) and how many days of dumps to keep.
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
