{
  "name": "ebb",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=24"
  },
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev:api": "node --watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite",
    "dev": "npm run dev:api & npm run dev:web",
    "build": "vite build",
    "start": "node src/server/index.ts",
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
